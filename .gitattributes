* text=auto

# Linux/VM runtime files must not receive Windows CRLF line endings.
*.sh text eol=lf
*.mjs text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep Windows-native automation consistent for local users.
*.ps1 text eol=crlf
