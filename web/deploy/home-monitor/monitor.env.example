PROACTIVE_MONITOR_ENABLED=true
PROACTIVE_POLL_MS=15000
PROACTIVE_LIGHT_OFFLINE_SECONDS=120
PROACTIVE_SWITCH_OFFLINE_SECONDS=120
PROACTIVE_CAMERA_OFFLINE_SECONDS=300
PROACTIVE_RECOVERY_SECONDS=60
PROACTIVE_LONG_RUNNING_SECONDS=14400
PROACTIVE_REPEAT_SECONDS=1800
PROACTIVE_MAX_ALERTS_PER_INCIDENT=2
PROACTIVE_MONITORED_ENTITIES=light.moes_matter_light,switch.smart_wi_fi_plug,camera.aqara_g350
PROACTIVE_LONG_RUNNING_ENTITIES=switch.smart_wi_fi_plug
PROACTIVE_HOOK_AGENT=home-monitor
PROACTIVE_HOOK_TOKEN_FILE=/home/vboxuser/.config/openclaw-smart-home/hook_token
PROACTIVE_NOTIFY_CHANNEL=line
PROACTIVE_NOTIFY_TO=replace-with-channel-recipient
PROACTIVE_STATE_FILE=/home/vboxuser/.local/share/openclaw-smart-home/monitor-state.json
