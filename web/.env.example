HOST=127.0.0.1
PORT=4173
ALLOWED_ORIGINS=https://192.168.0.102:8443,http://127.0.0.1:4174,http://localhost:4174
API_RATE_LIMIT_PER_MINUTE=120
ACTION_RATE_LIMIT_PER_MINUTE=12
